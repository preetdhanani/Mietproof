# Generator LLM (OpenAI-compatible endpoint)
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# Eval judge (separate entry; used only by the scheduled RAGAS tier)
JUDGE_BASE_URL=
JUDGE_MODEL=
JUDGE_API_KEY=

# Embedding model for the dense/hybrid retrieval backends
# default: intfloat/multilingual-e5-base  |  alternate: BAAI/bge-m3
EMBEDDING_MODEL=intfloat/multilingual-e5-base

# Retrieval backend: bm25 | dense | hybrid
RETRIEVAL_BACKEND=hybrid

# Versioned collection the app serves (bgb__<embedder-id>__v<N>)
# Cutover and rollback are changes to this variable.
ACTIVE_COLLECTION=

# Retrieval-confidence floor for the out-of-scope check.
# No default until calibrated; the pipeline loads evals/baselines/floor.json
# and this variable overrides it. Unset + no floor.json = floor bypassed (warning logged).
OUT_OF_SCOPE_FLOOR=

# Abuse protection
DAILY_TOKEN_BUDGET=
RATE_LIMIT_PER_HOUR=10
MAX_CONCURRENT_LLM=3

# Langfuse tracing (self-hosted)
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Pins which committed snapshot (corpus/snapshots/<stand-date>/) ingestion and
# evals read, instead of the latest. If the named snapshot directory does not
# exist, startup fails with an error listing the available snapshots.
CORPUS_STAND=
